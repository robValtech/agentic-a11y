{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A11y Analysis Result",
  "description": "Accessibility analysis output for a UI design image, listing detected elements and any associated WCAG issues.",
  "type": "object",
  "required": [
    "meta",
    "elements"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/definitions/meta"
    },
    "elements": {
      "type": "array",
      "description": "All UI elements detected in the design, with optional accessibility issues.",
      "items": {
        "$ref": "#/definitions/element"
      }
    },
    "flags": {
      "type": "array",
      "description": "Accessibility issues flagged at the page or section level, not tied to a specific element.",
      "items": {
        "$ref": "#/definitions/issue"
      }
    }
  },
  "definitions": {
    "meta": {
      "type": "object",
      "description": "Metadata about the analysis run.",
      "required": [
        "fileName",
        "modelName",
        "timestampStart",
        "timestampEnd",
        "prompt",
        "keyFindings"
      ],
      "additionalProperties": false,
      "properties": {
        "fileName": {
          "type": "string",
          "description": "The filename of the analysed design image.",
          "examples": [
            "podsite-desktop-home.jpg"
          ]
        },
        "modelName": {
          "type": "string",
          "description": "The AI model used to perform the analysis.",
          "examples": [
            "GPT-4.1 (copilot)"
          ]
        },
        "timestampStart": {
          "type": "number",
          "description": "Unix millisecond timestamp when the analysis started."
        },
        "timestampEnd": {
          "type": "number",
          "description": "Unix millisecond timestamp when the analysis completed."
        },
        "prompt": {
          "type": "string",
          "description": "The prompt used to instruct the model during analysis."
        },
        "keyFindings": {
          "type": "string",
          "description": "Key findings about the most common WCAG issues detected.",
          "examples": [
            "The most common issues found are related to poor colour contrast, missing labels, and icons potentially exposed to screen reader users."
          ]
        }
      }
    },
    "element": {
      "type": "object",
      "required": [
        "tag",
        "name",
        "position"
      ],
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string",
          "description": "The semantic HTML tag or ARIA role that best represents this element.",
          "anyOf": [
            {
              "$ref": "#/definitions/htmlElements"
            },
            {
              "$ref": "#/definitions/widgetRoles"
            },
            {
              "$ref": "#/definitions/documentStructureRoles"
            },
            {
              "$ref": "#/definitions/landmarkRoles"
            },
            {
              "$ref": "#/definitions/liveRegionRoles"
            },
            {
              "$ref": "#/definitions/windowRoles"
            },
            {
              "$ref": "#/definitions/legacyRoles"
            }
          ]
        },
        "name": {
          "type": "string",
          "description": "A human-readable label describing the element and its context in the UI."
        },
        "position": {
          "$ref": "#/definitions/position"
        },
        "issue": {
          "$ref": "#/definitions/issue"
        }
      }
    },
    "htmlElements": {
      "type": "string",
      "enum": [
        "a",
        "abbr",
        "address",
        "article",
        "aside",
        "audio",
        "blockquote",
        "button",
        "caption",
        "cite",
        "code",
        "data",
        "datalist",
        "dd",
        "del",
        "details",
        "dfn",
        "dialog",
        "dl",
        "dt",
        "em",
        "fieldset",
        "figcaption",
        "figure",
        "footer",
        "form",
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "header",
        "hgroup",
        "hr",
        "img",
        "input",
        "ins",
        "kbd",
        "label",
        "legend",
        "li",
        "main",
        "mark",
        "menu",
        "meter",
        "nav",
        "ol",
        "optgroup",
        "option",
        "output",
        "p",
        "picture",
        "pre",
        "progress",
        "q",
        "ruby",
        "s",
        "samp",
        "search",
        "section",
        "select",
        "small",
        "strong",
        "sub",
        "summary",
        "sup",
        "svg",
        "table",
        "tbody",
        "td",
        "textarea",
        "tfoot",
        "th",
        "thead",
        "time",
        "tr",
        "ul",
        "var",
        "video"
      ]
    },
    "widgetRoles": {
      "type": "string",
      "enum": [
        "button",
        "checkbox",
        "gridcell",
        "link",
        "menuitem",
        "menuitemcheckbox",
        "menuitemradio",
        "option",
        "progressbar",
        "radio",
        "scrollbar",
        "searchbox",
        "separator",
        "slider",
        "spinbutton",
        "switch",
        "tab",
        "tabpanel",
        "textbox",
        "treeitem",
        "combobox",
        "grid",
        "listbox",
        "menu",
        "menubar",
        "radiogroup",
        "tablist",
        "tree",
        "treegrid"
      ]
    },
    "documentStructureRoles": {
      "type": "string",
      "enum": [
        "application",
        "article",
        "blockquote",
        "caption",
        "cell",
        "code",
        "columnheader",
        "comment",
        "definition",
        "deletion",
        "directory",
        "document",
        "emphasis",
        "feed",
        "figure",
        "generic",
        "group",
        "heading",
        "img",
        "insertion",
        "list",
        "listitem",
        "mark",
        "math",
        "meter",
        "none",
        "note",
        "paragraph",
        "presentation",
        "row",
        "rowgroup",
        "rowheader",
        "strong",
        "subscript",
        "suggestion",
        "superscript",
        "table",
        "term",
        "time",
        "toolbar",
        "tooltip"
      ]
    },
    "landmarkRoles": {
      "type": "string",
      "enum": [
        "banner",
        "complementary",
        "contentinfo",
        "form",
        "main",
        "navigation",
        "region",
        "search"
      ]
    },
    "liveRegionRoles": {
      "type": "string",
      "enum": [
        "alert",
        "log",
        "marquee",
        "status",
        "timer"
      ]
    },
    "windowRoles": {
      "type": "string",
      "enum": [
        "alertdialog",
        "dialog"
      ]
    },
    "legacyRoles": {
      "type": "string",
      "enum": [
        "landmark"
      ]
    },
    "position": {
      "type": "object",
      "description": "Coordinates of the element within the image.",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "description": "Horizontal position of the element within the image.",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "description": "Vertical position of the element within the image.",
          "minimum": 0
        }
      }
    },
    "issue": {
      "type": "object",
      "description": "An accessibility issue found on this element.",
      "required": [
        "severity",
        "title",
        "wcag",
        "description",
        "fix"
      ],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "string",
          "description": "The impact level of the issue on users with disabilities.",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "title": {
          "type": "string",
          "description": "A short, descriptive title for the issue."
        },
        "wcag": {
          "type": "array",
          "description": "One or more WCAG success criterion numbers that this issue violates (e.g. '1.4.3').",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "examples": [
              "1.4.3",
              "4.1.2",
              "2.4.7"
            ]
          }
        },
        "description": {
          "type": "string",
          "description": "A full explanation of the issue, its impact, and who is affected."
        },
        "fix": {
          "type": "string",
          "description": "Actionable guidance on how to resolve the issue in code or design."
        }
      }
    }
  }
}
{
  "name": "agentic-a11y",
  "private": true,
  "scripts": {
    "test:scripts": "node --test 'ai/scripts/*.test.mjs'",
    "test:scripts:watch": "node --test --watch 'ai/scripts/*.test.mjs'",
    "test:scripts:coverage": "node --experimental-test-coverage --test 'ai/scripts/*.test.mjs'",
    "validate:analysis-json": "node ai/scripts/validate-json.mjs --schema ai/schemas/a11y.analyst.schema.json",
    "make:report": "node ai/scripts/generate-report.mjs --json temp/report/input/analysis.json --image temp/report/input/design.jpg --output temp/report/output --template-dir ai/templates"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}